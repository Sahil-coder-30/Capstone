# Sandbox subdomain router. Copy this file to a local env file and fill in real values.
PORT=3000
REDIS_URI=redis://localhost:6379

# Owner-only access to *.agent and *.preview (src/sandboxEdgeAuth.js).
AUTH_JWKS_URI=http://localhost:4000/.well-known/jwks.json
SANDBOX_SERVICE_URL=http://localhost:5000
# Shared with auth/sandbox for /internal calls; also used for the owner lookup.
INTERNAL_SERVICE_TOKEN=
# HMAC key for the session cookie, the new-tab ticket and preview share links.
# Missing: the edge fails closed. Generate one: openssl rand -hex 32
SANDBOX_SESSION_SECRET=
# Editor origins allowed to call /__taksha/session with credentials.
CLIENT_URL=http://localhost:5173

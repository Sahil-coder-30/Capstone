# Auth service. Copy this file to a local env file and fill in real values.
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb://localhost:27017/auth
REDIS_URI=redis://localhost:6379
MQ_URL=amqp://localhost:5672

# Google OAuth app credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# RS256 signing key. Optional if certs/private.pem exists (see certs/generate-keys.js).
# Use \n for line breaks when passing the PEM as one line.
RSA_PRIVATE_KEY=
RSA_PUBLIC_KEY=

TOKENS_PER_AI_CREDIT=1000
AI_BILLING_CENTS_PER_1K_TOKENS=2

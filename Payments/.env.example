# Payments service. Copy this file to a local env file and fill in real values.
PORT=5002
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/payments
# Only used by scripts/migrate_credits_from_auth.js
AUTH_MONGO_URI=
REDIS_URI=redis://localhost:6379
MQ_URL=amqp://localhost:5672
AUTH_JWKS_URI=http://localhost:3000/.well-known/jwks.json

# Razorpay (use rzp_test_ keys locally)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate secret configured in the Razorpay dashboard webhook settings
RAZORPAY_WEBHOOK_SECRET=
# Accept synthetic pay_test_* payments. Test mode only, never in production.
ALLOW_SYNTHETIC_PAYMENTS=false

# Razorpay plan ids per package
PLAN_ID_FREE=
PLAN_ID_PRO=
PLAN_ID_MAX=

TOKENS_PER_AI_CREDIT=1000
AI_BILLING_CENTS_PER_1K_TOKENS=2

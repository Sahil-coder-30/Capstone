# AI orchestration service. Copy this file to a local env file and fill in real values.
PORT=3000
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/ai
REDIS_URI=redis://localhost:6379
AUTH_JWKS_URI=http://localhost:3000/.well-known/jwks.json
PAYMENTS_SERVICE_URL=http://localhost:5002
# Used to verify that a sandbox belongs to the caller
SANDBOX_SERVICE_URL=http://localhost:4000

MISTRALAI_API_KEY=
# Optional. Mistral model id for the coding agent (Orion). mistral-large-latest needs a paid plan.
ORION_MODEL=codestral-latest
# Used for routing, structured plans and the final report. Defaults to ORION_MODEL.
ORION_FAST_MODEL=
# Internet search tool
TAVILY_API_KEY=

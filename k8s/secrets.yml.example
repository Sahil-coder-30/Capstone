apiVersion: v1
kind: Secret
metadata:
  name: database
type: Opaque
stringData:
  AUTH: AUTH_DATABASE_URL
  SANDBOX: SANDBOX_DATABASE_URL
  AI: AI_DATABASE_URL
  # Payments uses Postgres (Supabase transaction pooler, port 6543):
  # postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
  PAYMENT_DATABASE_URL: PAYMENTS_POSTGRES_URL
  REDIS_URL: redis://default
  MQ_URL: RABBITMQ_URL_URL

---
apiVersion: v1
kind: Secret
metadata:
  name: jwt
type: Opaque
stringData:
  JWT_SECRET: JWT_SECRET_VALUE

---
apiVersion: v1
kind: Secret
metadata:
  name: google
type: Opaque
stringData:
  GOOGLE_CLIENT_ID: GOOGLE_CLIENT_ID_VALUE
  GOOGLE_CLIENT_SECRET: GOOGLE_CLIENT_SECRET_VALUE
  GOOGLE_REFRESH_TOKEN: GOOGLE_REFRESH_TOKEN_VALUE
  EMAIL_USER: EMAIL_USER_VALUE

---
apiVersion: v1
kind: Secret
metadata:
  name: razorpay
type: Opaque
stringData:
  RAZORPAY_KEY_ID: RAZORPAY_KEY_ID_VALUE
  RAZORPAY_KEY_SECRET: RAZORPAY_KEY_SECRET_VALUE
  RAZORPAY_SECRET_ID: RAZORPAY_SECRET_ID_VALUE
  RAZORPAY_SECRET_KEY: RAZORPAY_SECRET_KEY_VALUE
  RAZORPAY_WEBHOOK_SECRET: RAZORPAY_WEBHOOK_SECRET_VALUE

---
apiVersion: v1
kind: Secret
metadata:
  name: ai-secret
type: Opaque
stringData:
  NVIDIA_API_KEY: NVIDIA_API_KEY_VALUE
  TAVILY_API_KEY: TAVILY_API_KEY_VALUE

---
apiVersion: v1
kind: Secret
metadata:
  name: aws
type: Opaque
stringData:
  AWS_REGION: ap-southeast-1
  AWS_ACCESS_KEY_ID: AWS_ACCESS_KEY_ID_VALUE
  AWS_SECRET_ACCESS_KEY: AWS_SECRET_ACCESS_KEY_VALUE

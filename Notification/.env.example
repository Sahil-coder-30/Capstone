# Notification service. Copy this file to a local env file and fill in real values.
MQ_URL=amqp://localhost:5672
AUTH_JWKS_URI=http://localhost:3000/.well-known/jwks.json

# Sender account (app password or OAuth2 refresh token)
EMAIL_USER=
EMAIL_PASS=
GMAIL_APP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
